#!/usr/bin/env bash
set -euo pipefail

session="${MOWA_HERD_SESSION:-mowa-herd}"
root="${MOWA_ROOT:-/home/szymon/mowa}"
agents="${MOWA_AGENTS:-/home/szymon/mowa-agents}"
work="${MOWA_WORK:-/home/szymon/mowa-work}"

ensure_workspace() {
  local name="$1"
  local path="$agents/$name"

  if [[ ! -d "$path" ]]; then
    /home/szymon/bin/mowa-new-agent "$name" >/dev/null
  fi
}

write_role_file() {
  local name="$1"
  local role="$2"
  local path="$3"
  local prompt="$root/docs/agents/prompts/$role.md"

  {
    echo "# Herd session"
    echo
    echo "Role: $role"
    echo "Name: $name"
    echo "Workspace: $path"
    echo "Shared state: $work"
    echo
    echo "## Start here"
    echo
    echo "1. Read this file."
    echo "2. Read AGENTS.md."
    echo "3. Use /home/szymon/mowa-work for tickets, handoffs, reviews, and board notes."
    echo
    echo "## Role prompt"
    echo
    cat "$prompt"
  } > "$path/HERD_SESSION.md"
}

window_note() {
  local target="$1"
  local file="$2"

  tmux send-keys -t "$target" "clear; printf 'Read %s first.\\n\\n' '$file'; sed -n '1,120p' '$file'" C-m
}

mkdir -p "$work"/{tickets,specs,handoffs,reviews,board}

ensure_workspace worker-1
ensure_workspace worker-2
ensure_workspace worker-3
ensure_workspace reviewer

write_role_file coordinator coordinator "$root"
write_role_file worker-1 worker "$agents/worker-1"
write_role_file worker-2 worker "$agents/worker-2"
write_role_file worker-3 worker "$agents/worker-3"
write_role_file reviewer reviewer "$agents/reviewer"

if tmux has-session -t "$session" 2>/dev/null; then
  if [[ -t 0 && -t 1 ]]; then
    tmux attach -t "$session"
  else
    echo "herd already running: $session"
    echo "attach with: tmux attach -t $session"
  fi
  exit 0
fi

tmux new-session -d -s "$session" -n coordinator -c "$root"
window_note "$session:coordinator" "$root/HERD_SESSION.md"

tmux new-window -t "$session" -n worker-1 -c "$agents/worker-1"
window_note "$session:worker-1" "$agents/worker-1/HERD_SESSION.md"

tmux new-window -t "$session" -n worker-2 -c "$agents/worker-2"
window_note "$session:worker-2" "$agents/worker-2/HERD_SESSION.md"

tmux new-window -t "$session" -n worker-3 -c "$agents/worker-3"
window_note "$session:worker-3" "$agents/worker-3/HERD_SESSION.md"

tmux new-window -t "$session" -n reviewer -c "$agents/reviewer"
window_note "$session:reviewer" "$agents/reviewer/HERD_SESSION.md"

tmux new-window -t "$session" -n board -c "$work"
tmux send-keys -t "$session:board" "clear; watch -n 5 /home/szymon/bin/mowa-board" C-m

tmux select-window -t "$session:coordinator"

if [[ -t 0 && -t 1 ]]; then
  tmux attach -t "$session"
else
  echo "started herd: $session"
  echo "attach with: tmux attach -t $session"
fi
