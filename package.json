{
  "name": "mowa",
  "version": "1.0.0",
  "description": "Dyktowanie glosowe na macOS",
  "main": "./out/main/index.js",
  "author": "szymon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:plist": "node scripts/dev-plist.js",
    "start": "electron-vite preview",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "eval": "tsx test/eval/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mac": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "diff": "^9.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "multilingual-stemmer": "^2.1.1"
  }
}
